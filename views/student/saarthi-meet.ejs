<%- include('../partials/head', { title: 'Doubt Saarthi Meet' }) %>
<style>
  body, html { margin: 0; padding: 0; height: 100%; overflow: hidden; }
  #jitsi-container { width: 100%; height: 100%; }
</style>
<script src='https://meet.jit.si/external_api.js'></script>
<body>
  <div id="jitsi-container"></div>
  
  <script src="/js/auth-guard.js"></script>
  <script>
    // Just verify they are logged in at a minimum
    const user = requireAuthAny(['student', 'sme', 'admin']);
    
    const domain = 'meet.jit.si';
    const options = {
        roomName: '<%= batch.jitsiRoomName %>', // The unguessable UUID from DB
        width: '100%',
        height: '100%',
        parentNode: document.querySelector('#jitsi-container'),
        userInfo: {
            displayName: user.name
        },
        configOverwrite: {
            startWithAudioMuted: true,
            startWithVideoMuted: true,
            disableModeratorIndicator: true,
            disableDeepLinking: true // Prevent prompting to download Jitsi app on mobile
        },
        interfaceConfigOverwrite: {
            SHOW_CHROME_EXTENSION_BANNER: false
        }
    };
    
    const api = new JitsiMeetExternalAPI(domain, options);
    
    // When the user hangs up, redirect them back to the chat
    api.addEventListener('videoConferenceLeft', () => {
        window.location.href = user.role === 'sme' || user.role === 'admin' 
          ? `/sme/saarthi/<%= batch._id %>` 
          : `/student/saarthi/<%= batch._id %>`;
    });
  </script>
</body>
</html>
