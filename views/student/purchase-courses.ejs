<%- include('../partials/head', { title: 'Purchase Courses' }) %>
<body class="min-h-screen bg-slate-50 text-gray-900">
  <%- include('../partials/navbar') %>
  <%- include('../partials/sidebar') %>

  <div class="md:ml-60 pt-14 min-h-screen page-body">
    <div class="bg-gradient-to-r from-garud-accent via-purple-600 to-blue-600 px-6 md:px-10 py-10 shadow-xl fade-up relative overflow-hidden">
      <!-- Decorative background blur -->
      <div class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 bg-white opacity-10 rounded-full blur-3xl"></div>
      <div class="relative z-10">
        <p class="text-white/70 text-xs font-bold uppercase tracking-widest mb-2">Student Portal</p>
        <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-2 drop-shadow-md">Purchase Courses</h1>
        <p class="text-white/80 text-sm md:text-base font-medium">Buy complete courses and unlock high-quality video lectures</p>
      </div>
    </div>

    <div class="p-6 md:p-8">
      <div class="mb-6">
        <select id="category-filter" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 outline-none">
          <option value="all">All Categories</option>
          <option value="jee">JEE</option>
          <option value="neet">NEET</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div id="loading" class="flex items-center justify-center py-12"><div class="spinner"></div></div>
      <div id="courses-grid" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </div>
  </div>

  <%- include('../partials/toast') %>
  <script src="/js/api.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/auth-guard.js"></script>
  <script src="/js/sidebar.js"></script>
  <script src="/js/pages/student/purchase-courses.js"></script>
</body>
</html>
