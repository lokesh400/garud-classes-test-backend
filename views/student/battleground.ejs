<%- include('../partials/head', { title: 'Battleground' }) %>
<body class="min-h-screen bg-slate-50 text-gray-900">
  <%- include('../partials/navbar') %>
  <%- include('../partials/sidebar') %>

  <div class="md:ml-60 pt-14 min-h-screen page-body">
    <div class="bg-gradient-to-r from-slate-900 via-indigo-900 to-slate-900 px-6 md:px-10 py-10 shadow-xl fade-up relative overflow-hidden border-b border-indigo-500/30">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSIvPjwvc3ZnPg==')] opacity-30"></div>
      <div class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 bg-indigo-500 opacity-20 rounded-full blur-3xl"></div>
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <p class="text-indigo-300 text-xs font-bold uppercase tracking-widest mb-2">Student Portal</p>
          <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-2 drop-shadow-md">Daily Battleground</h1>
          <p class="text-indigo-200 text-sm md:text-base font-medium">Solve today's class-wise subject quizzes and keep your streak alive.</p>
        </div>
        <a href="/student/battleground-prizes"
           class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-indigo-400/30 rounded-xl text-sm font-bold transition-all duration-300 shadow-lg hover:shadow-indigo-500/20 hover:-translate-y-0.5">
          <svg class="w-4 h-4 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path></svg> View Prize Roadmap
        </a>
      </div>
    </div>

    <div class="p-6 md:p-8 space-y-6">
      <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 md:p-6 lift fade-up-1">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <p class="text-xs uppercase tracking-wide text-gray-500">Current Streak</p>
            <p id="streak-current" class="text-2xl font-bold text-gray-900 mt-1">0</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wide text-gray-500">Best Streak</p>
            <p id="streak-best" class="text-2xl font-bold text-gray-900 mt-1">0</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wide text-gray-500">Today's Progress</p>
            <p id="streak-progress" class="text-sm font-semibold text-gray-900 mt-2">-</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wide text-gray-500">Date</p>
            <p id="streak-date" class="text-sm font-semibold text-gray-900 mt-2">-</p>
          </div>
        </div>
      </section>

      <section id="battleground-loading" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 text-sm text-gray-500">
        Loading today's battleground...
      </section>

      <section id="battleground-error" class="hidden bg-white rounded-2xl shadow-sm border border-red-100 p-6 text-sm text-red-600"></section>

      <section id="battleground-content" class="hidden space-y-4"></section>
    </div>
  </div>

  <%- include('../partials/toast') %>
  <script src="/js/api.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/auth-guard.js"></script>
  <script src="/js/sidebar.js"></script>
  <script src="/js/pages/student/battleground.js"></script>
</body>
</html>
