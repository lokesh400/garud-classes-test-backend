<%- include('../partials/head', { title: 'Doubt Saarthi' }) %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<body class="min-h-screen bg-gray-50 flex">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/navbar') %>

  <main class="flex-grow pt-20 p-6 md:ml-[260px]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-800">My Doubt Saarthi Batches</h1>
        <p class="text-slate-500 mt-2">Access your interactive doubt clearing sessions here.</p>
      </div>

      <% if (!batches || batches.length === 0) { %>
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-12 text-center">
          <div class="w-20 h-20 bg-indigo-50 rounded-full flex items-center justify-center mx-auto mb-4 text-indigo-500">
            <i class="fas fa-hands-helping text-3xl"></i>
          </div>
          <h2 class="text-xl font-bold text-slate-800 mb-2">No Saarthi Batches Yet</h2>
          <p class="text-slate-500 mb-6">You haven't enrolled in any Doubt Saarthi programs.</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% batches.forEach(batch => { %>
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col hover:shadow-md transition-shadow">
              <div class="p-6 flex-grow">
                <h3 class="font-bold text-lg text-slate-800 mb-2"><%= batch.title %></h3>
                <p class="text-slate-500 text-sm mb-4 line-clamp-2"><%= batch.description %></p>
                
                <div class="flex items-center gap-2 mb-4">
                  <span class="px-2 py-1 bg-slate-100 text-slate-600 rounded text-xs font-medium">Valid <%= batch.validity %> Days</span>
                  <% if (batch.isMeetActive) { %>
                    <span class="px-2 py-1 bg-red-50 text-red-600 rounded text-xs font-medium flex items-center gap-1 animate-pulse">
                      <div class="w-2 h-2 rounded-full bg-red-500"></div>
                      Live Meet
                    </span>
                  <% } %>
                </div>
              </div>
              <div class="p-4 bg-slate-50 border-t border-slate-100">
                <a href="/student/saarthi/<%= batch._id %>" class="w-full block text-center py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-colors">
                  Enter Chat
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
