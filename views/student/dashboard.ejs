        <%- include('../partials/toast') %>


          <script src="/js/api.js"></script>

          <script src="/js/toast.js"></script>

          <script src="/js/auth-guard.js"></script>

          <script src="/js/sidebar.js"></script>


          <script>
            document.addEventListener(
              'DOMContentLoaded',
              async () => {

                requireAuth('student');


                const user = getUser();


                if (user) {

                  const welcomeTitle =
                    document.getElementById(
                      'welcome-title'
                    );


                  if (welcomeTitle) {

                    const firstName =
                      String(user.name || 'Student')
                        .split(' ')[0];


                    welcomeTitle.textContent =
                      `Welcome back, ${firstName}!`;

                  }

                }



                const cohortSelector =
                  document.getElementById(
                    'cohort-selector'
                  );


                const cohortEmptyState =
                  document.getElementById(
                    'cohort-empty-state'
                  );


                const cohortScheduleContent =
                  document.getElementById(
                    'cohort-schedule-content'
                  );


                const sectionOngoing =
                  document.getElementById(
                    'section-ongoing'
                  );


                const sectionUpcoming =
                  document.getElementById(
                    'section-upcoming'
                  );


                const sectionCompleted =
                  document.getElementById(
                    'section-completed'
                  );


                const sectionCancelled =
                  document.getElementById(
                    'section-cancelled'
                  );


                const containerOngoing =
                  document.getElementById(
                    'container-ongoing'
                  );


                const containerUpcoming =
                  document.getElementById(
                    'container-upcoming'
                  );


                const containerCompleted =
                  document.getElementById(
                    'container-completed'
                  );


                const containerCancelled =
                  document.getElementById(
                    'container-cancelled'
                  );


                let activeCourse = null;



                try {

                  const purchases = await API.get(
                    '/purchase/my?itemType=Course'
                  );


                  if (
                    !purchases ||
                    purchases.length === 0
                  ) {

                    cohortSelector.innerHTML = `
          <option value="">
            No courses purchased
          </option>
        `;


                    cohortEmptyState.classList.remove(
                      'hidden'
                    );


                    cohortScheduleContent.classList.add(
                      'hidden'
                    );


                    return;

                  }



                  cohortSelector.innerHTML =
                    purchases
                      .map((purchase, index) => {

                        const course =
                          purchase.course ||
                          purchase.itemId;


                        if (!course) {

                          return '';

                        }


                        return `
              <option
                value="${course._id}"
                ${index === 0
                            ? 'selected'
                            : ''}
              >
                ${escapeHtml(course.name)}
              </option>
            `;

                      })
                      .join('');



                  const firstCourse =
                    purchases[0].course ||
                    purchases[0].itemId;


                  if (firstCourse) {

                    await loadCohortDetails(
                      firstCourse._id
                    );

                  }



                  cohortSelector.addEventListener(
                    'change',
                    async event => {

                      const courseId =
                        event.target.value;


                      if (courseId) {

                        await loadCohortDetails(
                          courseId
                        );

                      }

                    }
                  );


                } catch (error) {

                  console.error(error);


                  cohortSelector.innerHTML = `
        <option value="">
          Error loading courses
        </option>
      `;

                }



                async function loadCohortDetails(
                  courseId
                ) {

                  try {

                    const course = await API.get(
                      `/courses/published/${courseId}`
                    );


                    activeCourse = course;


                    renderSchedule();


                  } catch (error) {

                    console.error(
                      'Error loading schedule:',
                      error
                    );

                  }

                }



                function renderSchedule() {

                  if (!activeCourse) {

                    return;

                  }


                  cohortEmptyState.classList.add(
                    'hidden'
                  );


                  cohortScheduleContent.classList.remove(
                    'hidden'
                  );


                  const ongoingList = [];

                  const upcomingList = [];

                  const completedList = [];

                  const cancelledList = [];



                  if (
                    Array.isArray(
                      activeCourse.subjects
                    )
                  ) {

                    activeCourse.subjects.forEach(
                      subject => {

                        if (
                          !subject ||
                          !Array.isArray(
                            subject.chapters
                          )
                        ) {

                          return;

                        }


                        subject.chapters.forEach(
                          chapter => {

                            if (
                              !chapter ||
                              !Array.isArray(
                                chapter.lectures
                              )
                            ) {

                              return;

                            }


                            chapter.lectures.forEach(
                              lecture => {

                                const lectureData = {

                                  ...lecture,

                                  subjectName:
                                    subject.name,

                                  chapterName:
                                    chapter.name

                                };


                                if (
                                  lecture.status === 'live'
                                ) {

                                  ongoingList.push(
                                    lectureData
                                  );

                                }

                                else if (
                                  lecture.status ===
                                  'scheduled'
                                ) {

                                  upcomingList.push(
                                    lectureData
                                  );

                                }

                                else if (
                                  lecture.status ===
                                  'cancelled'
                                ) {

                                  cancelledList.push(
                                    lectureData
                                  );

                                }

                                else if (
                                  lecture.scheduledAt
                                ) {

                                  const today =
                                    new Date();


                                  const lectureDate =
                                    new Date(
                                      lecture.scheduledAt
                                    );


                                  if (
                                    lectureDate.getFullYear() ===
                                    today.getFullYear() &&

                                    lectureDate.getMonth() ===
                                    today.getMonth() &&

                                    lectureDate.getDate() ===
                                    today.getDate()
                                  ) {

                                    completedList.push(
                                      lectureData
                                    );

                                  }

                                }

                              }
                            );

                          }
                        );

                      }
                    );

                  }



                  renderHorizontalList(
                    ongoingList,
                    sectionOngoing,
                    containerOngoing,
                    'No live classes right now.'
                  );


                  renderHorizontalList(
                    upcomingList,
                    sectionUpcoming,
                    containerUpcoming,
                    'No upcoming classes scheduled.'
                  );


                  renderHorizontalList(
                    completedList,
                    sectionCompleted,
                    containerCompleted,
                    'No lectures completed today.'
                  );


                  renderHorizontalList(
                    cancelledList,
                    sectionCancelled,
                    containerCancelled,
                    'No cancelled classes.'
                  );

                }



                function renderHorizontalList(
                  list,
                  sectionElement,
                  containerElement,
                  emptyMessage
                ) {

                  sectionElement.classList.remove(
                    'hidden'
                  );


                  if (
                    !list ||
                    list.length === 0
                  ) {

                    containerElement.innerHTML = `

          <div class="schedule-empty">

            <i
              class="far fa-calendar"
              style="
                display:block;
                margin-bottom:9px;
                font-size:20px;
              "
            ></i>

            ${emptyMessage}

          </div>

        `;


                    return;

                  }



                  containerElement.innerHTML =
                    list
                      .map(lecture => {


                        let type = 'completed';

                        let icon = 'fa-play';

                        let badge = 'Completed';

                        let actionHtml = '';



                        if (
                          lecture.status === 'live'
                        ) {

                          type = 'live';

                          icon = 'fa-video';

                          badge = 'Live Now';


                          actionHtml = `

                <a

                  href="
                    /student/course/
                    ${activeCourse._id}
                    /player?lectureId=
                    ${lecture._id}
                  "

                  class="
                    lecture-button
                    lecture-button-live
                  "

                >

                  <i class="fas fa-play"></i>

                  Join Live Class

                </a>

              `.replace(/\s+/g, ' ');

                        }


                        else if (
                          lecture.status ===
                          'scheduled'
                        ) {

                          type = 'scheduled';

                          icon = 'fa-calendar';

                          badge = 'Upcoming';


                          actionHtml = `

                <div
                  class="
                    lecture-info-button
                    lecture-info-upcoming
                  "
                >

                  <i class="far fa-clock"></i>

                  ${formatScheduledDate(
                            lecture.scheduledAt
                          )}

                </div>

              `;

                        }


                        else if (
                          lecture.status ===
                          'cancelled'
                        ) {

                          type = 'cancelled';

                          icon = 'fa-calendar-xmark';

                          badge = 'Cancelled';


                          actionHtml = `

                <div
                  class="
                    lecture-info-button
                    lecture-info-cancelled
                  "
                >

                  <i
                    class="
                      fas
                      fa-circle-xmark
                    "
                  ></i>

                  Class Cancelled

                </div>

              `;

                        }


                        else {

                          actionHtml = `

                <a

                  href="
                    /student/course/
                    ${activeCourse._id}
                    /player?lectureId=
                    ${lecture._id}
                  "

                  class="
                    lecture-button
                    lecture-button-completed
                  "

                >

                  <i class="fas fa-play"></i>

                  Watch Recording

                </a>

              `.replace(/\s+/g, ' ');

                        }



                        return `

              <article
                class="
                  lecture-card
                  ${type}
                "
              >


                <div class="lecture-card-top">


                  <div class="lecture-type-icon">

                    <i
                      class="
                        fas
                        ${icon}
                      "
                    ></i>

                  </div>


                  <span
                    class="
                      lecture-badge
                      ${type}
                    "
                  >

                    ${badge}

                  </span>


                </div>



                <p
                  class="lecture-subject"

                  title="
                    ${escapeHtml(
                          lecture.subjectName
                        )}
                    -
                    ${escapeHtml(
                          lecture.chapterName
                        )}
                  "
                >

                  ${escapeHtml(
                          lecture.subjectName
                        )}

                  ·

                  ${escapeHtml(
                          lecture.chapterName
                        )}

                </p>



                <h4 class="lecture-title">

                  ${escapeHtml(
                          lecture.title
                        )}

                </h4>



                <div class="lecture-action-area">

                  ${actionHtml}

                </div>


              </article>

            `;

                      })
                      .join('');

                }



                function formatScheduledDate(
                  dateString
                ) {

                  if (!dateString) {

                    return 'Schedule TBD';

                  }


                  const date =
                    new Date(dateString);


                  if (
                    Number.isNaN(
                      date.getTime()
                    )
                  ) {

                    return 'Schedule TBD';

                  }


                  return date.toLocaleDateString(
                    'en-IN',
                    {

                      day: '2-digit',

                      month: 'short',

                      hour: '2-digit',

                      minute: '2-digit',

                      hour12: true

                    }
                  );

                }



                function escapeHtml(value) {

                  if (
                    value === null ||
                    value === undefined
                  ) {

                    return '';

                  }


                  return String(value)

                    .replace(
                      /&/g,
                      '&amp;'
                    )

                    .replace(
                      /</g,
                      '&lt;'
                    )

                    .replace(
                      />/g,
                      '&gt;'
                    )

                    .replace(
                      /"/g,
                      '&quot;'
                    )

                    .replace(
                      /'/g,
                      '&#039;'
                    );

                }

              }
            );
          </script>


  </body>

  </html>