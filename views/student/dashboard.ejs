<%- include('../partials/head', { title: 'Dashboard' }) %>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <body class="min-h-screen">

    <%- include('../partials/navbar') %>
      <%- include('../partials/sidebar') %>

        <style>
          @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

          :root {
            --primary: #6D28D9;
            --primary-dark: #4C1D95;
            --primary-medium: #7C3AED;
            --primary-light: #EDE9FE;
            --primary-soft: #F5F3FF;

            --background: #F8F7FC;
            --surface: #FFFFFF;

            --text: #171717;
            --text-secondary: #64748B;
            --text-muted: #94A3B8;

            --border: #E8E5EF;

            --green: #16A34A;
            --green-soft: #DCFCE7;

            --red: #DC2626;
            --red-soft: #FEE2E2;

            --blue: #2563EB;
            --blue-soft: #DBEAFE;

            --orange: #EA580C;
            --orange-soft: #FFEDD5;
          }

          * {
            box-sizing: border-box;
          }

          html,
          body {
            margin: 0;
            min-height: 100%;

            background: var(--background);

            color: var(--text);

            font-family: 'Inter', sans-serif;
          }

          button,
          select,
          input {
            font-family: inherit;
          }

          .hidden {
            display: none !important;
          }


          /* =========================================================
   DASHBOARD
========================================================= */

          .dashboard-shell {
            min-height: calc(100vh - 3.5rem);

            background:
              radial-gradient(circle at 8% 5%,
                rgba(109, 40, 217, 0.07),
                transparent 26%),
              radial-gradient(circle at 95% 40%,
                rgba(139, 92, 246, 0.05),
                transparent 24%),
              var(--background);
          }

          .dashboard-container {
            width: 100%;
            max-width: 1500px;

            margin: 0 auto;

            padding: 24px 28px 45px;
          }


          /* =========================================================
   HERO
========================================================= */

          .dashboard-hero {
            position: relative;

            min-height: 225px;

            padding: 34px 38px;

            overflow: hidden;

            border-radius: 26px;

            background:
              linear-gradient(125deg,
                #4C1D95 0%,
                #6D28D9 52%,
                #8B5CF6 100%);

            box-shadow:
              0 8px 20px rgba(76, 29, 149, 0.12),
              0 24px 55px rgba(109, 40, 217, 0.18);
          }

          .dashboard-hero::before {
            content: '';

            position: absolute;

            width: 380px;
            height: 380px;

            top: -230px;
            right: -70px;

            border-radius: 50%;

            background: rgba(255, 255, 255, 0.11);
          }

          .dashboard-hero::after {
            content: '';

            position: absolute;

            width: 270px;
            height: 270px;

            bottom: -190px;
            left: 38%;

            border-radius: 50%;

            background: rgba(255, 255, 255, 0.07);
          }

          .hero-grid {
            position: relative;

            z-index: 2;

            min-height: 157px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 35px;
          }

          .hero-content {
            max-width: 650px;
          }

          .hero-label {
            display: inline-flex;
            align-items: center;

            gap: 8px;

            margin-bottom: 15px;

            padding: 7px 12px;

            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 999px;

            background: rgba(255, 255, 255, 0.11);

            color: rgba(255, 255, 255, 0.92);

            font-size: 10px;
            font-weight: 800;

            letter-spacing: 0.12em;
            text-transform: uppercase;
          }

          .hero-label-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;

            background: #86EFAC;

            box-shadow:
              0 0 0 5px rgba(134, 239, 172, 0.15);
          }

          .hero-title {
            margin: 0;

            color: #FFFFFF;

            font-size: clamp(26px, 3vw, 42px);
            font-weight: 900;

            letter-spacing: -0.045em;

            line-height: 1.08;
          }

          .hero-description {
            max-width: 540px;

            margin: 13px 0 0;

            color: rgba(255, 255, 255, 0.72);

            font-size: 13px;
            font-weight: 500;

            line-height: 21px;
          }

          .hero-visual {
            position: relative;

            width: 240px;
            height: 150px;

            flex-shrink: 0;
          }

          .hero-card {
            position: absolute;

            width: 170px;

            padding: 16px;

            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 20px;

            background: rgba(255, 255, 255, 0.13);

            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);

            box-shadow:
              0 15px 35px rgba(31, 15, 71, 0.18);
          }

          .hero-card-one {
            top: 0;
            right: 5px;

            transform: rotate(4deg);
          }

          .hero-card-two {
            bottom: 0;
            left: 0;

            transform: rotate(-5deg);
          }

          .hero-card-icon {
            width: 40px;
            height: 40px;

            margin-bottom: 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 13px;

            background: rgba(255, 255, 255, 0.17);

            color: #FFFFFF;

            font-size: 17px;
          }

          .hero-card-label {
            color: rgba(255, 255, 255, 0.65);

            font-size: 9px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 0.1em;
          }

          .hero-card-value {
            margin-top: 4px;

            color: #FFFFFF;

            font-size: 14px;
            font-weight: 800;
          }


          /* =========================================================
   COHORT CARD
========================================================= */

          .cohort-card {
            margin-top: 22px;

            padding: 20px 22px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            border: 1px solid var(--border);
            border-radius: 20px;

            background: rgba(255, 255, 255, 0.94);

            box-shadow:
              0 3px 8px rgba(15, 23, 42, 0.025),
              0 12px 30px rgba(15, 23, 42, 0.04);
          }

          .cohort-info {
            display: flex;
            align-items: center;

            gap: 14px;
          }

          .cohort-icon {
            width: 48px;
            height: 48px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 15px;

            background: var(--primary-soft);

            color: var(--primary);

            font-size: 19px;
          }

          .cohort-title {
            margin: 0;

            color: var(--text);

            font-size: 15px;
            font-weight: 800;

            letter-spacing: -0.02em;
          }

          .cohort-description {
            margin: 5px 0 0;

            color: var(--text-muted);

            font-size: 10px;
            font-weight: 500;
          }

          .cohort-select-wrapper {
            position: relative;

            min-width: 260px;
          }

          .cohort-select-icon {
            position: absolute;

            top: 50%;
            left: 14px;

            z-index: 2;

            transform: translateY(-50%);

            color: var(--primary);

            font-size: 13px;

            pointer-events: none;
          }

          #cohort-selector {
            width: 100%;
            height: 46px;

            padding: 0 40px 0 40px;

            appearance: none;
            -webkit-appearance: none;

            outline: none;

            border: 1px solid var(--border);
            border-radius: 14px;

            background: var(--primary-soft);

            color: var(--text);

            font-size: 11px;
            font-weight: 700;

            cursor: pointer;

            transition: 0.2s ease;
          }

          #cohort-selector:hover,
          #cohort-selector:focus {
            border-color: #C4B5FD;

            background: #FFFFFF;

            box-shadow:
              0 0 0 4px rgba(109, 40, 217, 0.07);
          }

          .cohort-chevron {
            position: absolute;

            top: 50%;
            right: 15px;

            transform: translateY(-50%);

            color: var(--text-muted);

            font-size: 10px;

            pointer-events: none;
          }


          /* =========================================================
   EMPTY STATE
========================================================= */

          .empty-state {
            margin-top: 22px;

            padding: 60px 25px;

            text-align: center;

            border: 1px solid var(--border);
            border-radius: 22px;

            background: #FFFFFF;
          }

          .empty-state-icon {
            width: 66px;
            height: 66px;

            margin: 0 auto 17px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 21px;

            background: var(--primary-soft);

            color: var(--primary);

            font-size: 25px;
          }

          .empty-state-title {
            margin: 0;

            color: var(--text);

            font-size: 17px;
            font-weight: 800;
          }

          .empty-state-description {
            max-width: 430px;

            margin: 8px auto 0;

            color: var(--text-muted);

            font-size: 11px;
            font-weight: 500;

            line-height: 18px;
          }

          .empty-state-button {
            margin-top: 20px;

            padding: 11px 18px;

            display: inline-flex;
            align-items: center;

            gap: 8px;

            border-radius: 12px;

            background: var(--primary);

            color: #FFFFFF;

            font-size: 11px;
            font-weight: 700;

            text-decoration: none;

            transition: 0.2s ease;
          }

          .empty-state-button:hover {
            background: var(--primary-dark);

            transform: translateY(-2px);

            box-shadow:
              0 10px 22px rgba(109, 40, 217, 0.22);
          }


          /* =========================================================
   SCHEDULE
========================================================= */

          .schedule-content {
            margin-top: 22px;

            display: flex;
            flex-direction: column;

            gap: 18px;
          }

          .schedule-section {
            padding: 21px;

            overflow: hidden;

            border: 1px solid var(--border);
            border-radius: 20px;

            background: #FFFFFF;

            box-shadow:
              0 3px 8px rgba(15, 23, 42, 0.02),
              0 12px 28px rgba(15, 23, 42, 0.035);
          }

          .schedule-heading {
            margin-bottom: 18px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 15px;
          }

          .schedule-heading-left {
            display: flex;
            align-items: center;

            gap: 12px;
          }

          .schedule-icon {
            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 13px;

            font-size: 16px;
          }

          .schedule-icon-live {
            background: var(--red-soft);

            color: var(--red);
          }

          .schedule-icon-upcoming {
            background: var(--blue-soft);

            color: var(--blue);
          }

          .schedule-icon-completed {
            background: var(--green-soft);

            color: var(--green);
          }

          .schedule-icon-cancelled {
            background: #F1F5F9;

            color: #64748B;
          }

          .schedule-title {
            margin: 0;

            color: var(--text);

            font-size: 15px;
            font-weight: 800;

            letter-spacing: -0.02em;
          }

          .schedule-subtitle {
            margin: 4px 0 0;

            color: var(--text-muted);

            font-size: 9px;
            font-weight: 500;
          }

          .live-indicator {
            display: inline-flex;
            align-items: center;

            gap: 7px;

            padding: 7px 11px;

            border-radius: 999px;

            background: var(--red-soft);

            color: var(--red);

            font-size: 9px;
            font-weight: 800;

            text-transform: uppercase;
            letter-spacing: 0.08em;
          }

          .live-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;

            background: var(--red);

            animation: livePulse 1.5s infinite;
          }

          @keyframes livePulse {
            0% {
              box-shadow:
                0 0 0 0 rgba(220, 38, 38, 0.5);
            }

            70% {
              box-shadow:
                0 0 0 7px rgba(220, 38, 38, 0);
            }

            100% {
              box-shadow:
                0 0 0 0 rgba(220, 38, 38, 0);
            }
          }

          .schedule-list {
            display: flex;

            gap: 13px;

            padding: 2px 2px 6px;

            overflow-x: auto;

            scroll-snap-type: x mandatory;

            scrollbar-width: none;
          }

          .schedule-list::-webkit-scrollbar {
            display: none;
          }


          /* =========================================================
   LECTURE CARDS
========================================================= */

          .lecture-card {
            position: relative;

            min-width: 275px;
            width: 275px;

            padding: 18px;

            overflow: hidden;

            flex-shrink: 0;

            scroll-snap-align: start;

            border: 1px solid var(--border);
            border-radius: 17px;

            background:
              linear-gradient(180deg,
                #FFFFFF 0%,
                #FCFBFF 100%);

            transition:
              transform 0.22s ease,
              border-color 0.22s ease,
              box-shadow 0.22s ease;
          }

          .lecture-card:hover {
            transform: translateY(-4px);

            border-color: #D8D1E8;

            box-shadow:
              0 15px 32px rgba(76, 29, 149, 0.09);
          }

          .lecture-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;

            gap: 10px;
          }

          .lecture-type-icon {
            width: 40px;
            height: 40px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 13px;

            font-size: 15px;
          }

          .lecture-card.live .lecture-type-icon {
            background: var(--red-soft);

            color: var(--red);
          }

          .lecture-card.scheduled .lecture-type-icon {
            background: var(--blue-soft);

            color: var(--blue);
          }

          .lecture-card.completed .lecture-type-icon {
            background: var(--green-soft);

            color: var(--green);
          }

          .lecture-card.cancelled .lecture-type-icon {
            background: #F1F5F9;

            color: #64748B;
          }

          .lecture-badge {
            padding: 6px 9px;

            border-radius: 999px;

            font-size: 8px;
            font-weight: 800;

            letter-spacing: 0.08em;
            text-transform: uppercase;
          }

          .lecture-badge.live {
            background: var(--red-soft);

            color: var(--red);
          }

          .lecture-badge.scheduled {
            background: var(--blue-soft);

            color: var(--blue);
          }

          .lecture-badge.completed {
            background: var(--green-soft);

            color: var(--green);
          }

          .lecture-badge.cancelled {
            background: #F1F5F9;

            color: #64748B;
          }

          .lecture-subject {
            margin: 17px 0 0;

            color: var(--primary);

            font-size: 9px;
            font-weight: 800;

            letter-spacing: 0.08em;
            text-transform: uppercase;

            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          }

          .lecture-title {
            min-height: 40px;

            margin: 7px 0 0;

            color: var(--text);

            font-size: 14px;
            font-weight: 800;

            line-height: 20px;

            letter-spacing: -0.02em;

            display: -webkit-box;

            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;

            overflow: hidden;
          }

          .lecture-action-area {
            margin-top: 17px;
            padding-top: 14px;

            border-top: 1px solid #F0EDF5;
          }

          .lecture-button {
            width: 100%;
            min-height: 41px;

            padding: 0 14px;

            display: flex;
            align-items: center;
            justify-content: center;

            gap: 8px;

            border-radius: 12px;

            font-size: 10px;
            font-weight: 800;

            text-decoration: none;

            transition: 0.2s ease;
          }

          .lecture-button-live {
            background: var(--red);

            color: #FFFFFF;
          }

          .lecture-button-live:hover {
            background: #B91C1C;

            transform: translateY(-1px);

            box-shadow:
              0 8px 18px rgba(220, 38, 38, 0.2);
          }

          .lecture-button-completed {
            background: var(--primary-soft);

            color: var(--primary);
          }

          .lecture-button-completed:hover {
            background: var(--primary);

            color: #FFFFFF;
          }

          .lecture-info-button {
            width: 100%;
            min-height: 41px;

            padding: 0 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            gap: 7px;

            border-radius: 12px;

            font-size: 10px;
            font-weight: 700;
          }

          .lecture-info-upcoming {
            background: #EFF6FF;

            color: var(--blue);

            border: 1px solid #DBEAFE;
          }

          .lecture-info-cancelled {
            background: #F8FAFC;

            color: #94A3B8;

            border: 1px solid #E2E8F0;
          }

          .schedule-empty {
            width: 100%;

            padding: 35px 20px;

            text-align: center;

            border: 1px dashed #D8D3E3;
            border-radius: 15px;

            background: #FCFBFF;

            color: var(--text-muted);

            font-size: 10px;
            font-weight: 600;
          }


          /* =========================================================
   QUICK ACTIONS
========================================================= */

          .quick-section {
            margin-top: 25px;
          }

          .quick-heading {
            margin-bottom: 14px;

            display: flex;
            align-items: flex-end;
            justify-content: space-between;

            gap: 15px;
          }

          .quick-title {
            margin: 0;

            color: var(--text);

            font-size: 18px;
            font-weight: 900;

            letter-spacing: -0.035em;
          }

          .quick-subtitle {
            margin: 5px 0 0;

            color: var(--text-muted);

            font-size: 10px;
            font-weight: 500;
          }

          .quick-grid {
            display: grid;

            grid-template-columns: repeat(4, minmax(0, 1fr));

            gap: 14px;
          }

          .quick-card {
            position: relative;

            min-height: 165px;

            padding: 20px;

            overflow: hidden;

            border: 1px solid var(--border);
            border-radius: 19px;

            background: #FFFFFF;

            color: inherit;

            text-decoration: none;

            transition:
              transform 0.22s ease,
              box-shadow 0.22s ease,
              border-color 0.22s ease;
          }

          .quick-card::after {
            content: '';

            position: absolute;

            width: 100px;
            height: 100px;

            right: -55px;
            bottom: -55px;

            border-radius: 50%;

            background: var(--primary-soft);

            transition: 0.25s ease;
          }

          .quick-card:hover {
            transform: translateY(-5px);

            border-color: #D8D1E8;

            box-shadow:
              0 18px 38px rgba(76, 29, 149, 0.09);
          }

          .quick-card:hover::after {
            width: 150px;
            height: 150px;

            right: -70px;
            bottom: -70px;
          }

          .quick-icon {
            position: relative;

            z-index: 2;

            width: 46px;
            height: 46px;

            margin-bottom: 18px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 15px;

            font-size: 18px;
          }

          .quick-icon-purple {
            background: var(--primary-soft);

            color: var(--primary);
          }

          .quick-icon-green {
            background: var(--green-soft);

            color: var(--green);
          }

          .quick-icon-blue {
            background: var(--blue-soft);

            color: var(--blue);
          }

          .quick-icon-orange {
            background: var(--orange-soft);

            color: var(--orange);
          }

          .quick-card-title {
            position: relative;

            z-index: 2;

            margin: 0;

            color: var(--text);

            font-size: 14px;
            font-weight: 800;
          }

          .quick-card-description {
            position: relative;

            z-index: 2;

            max-width: 210px;

            margin: 7px 0 0;

            color: var(--text-muted);

            font-size: 10px;
            font-weight: 500;

            line-height: 17px;
          }

          .quick-arrow {
            position: absolute;

            z-index: 3;

            right: 18px;
            bottom: 18px;

            width: 31px;
            height: 31px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;

            background: #FFFFFF;

            color: var(--primary);

            font-size: 11px;

            box-shadow:
              0 4px 12px rgba(15, 23, 42, 0.08);

            transition: 0.2s ease;
          }

          .quick-card:hover .quick-arrow {
            transform: translateX(3px);
          }


          /* =========================================================
   RESPONSIVE
========================================================= */

          @media (max-width: 1024px) {
            .quick-grid {
              grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .hero-visual {
              display: none;
            }
          }


          @media (max-width: 768px) {
            .dashboard-container {
              padding: 14px 12px 35px;
            }

            .dashboard-hero {
              min-height: auto;

              padding: 27px 23px;

              border-radius: 21px;
            }

            .hero-grid {
              min-height: auto;
            }

            .hero-title {
              font-size: 27px;
            }

            .hero-description {
              font-size: 11px;

              line-height: 18px;
            }

            .cohort-card {
              padding: 16px;

              flex-direction: column;
              align-items: stretch;

              border-radius: 18px;
            }

            .cohort-select-wrapper {
              min-width: 0;
              width: 100%;
            }

            .schedule-section {
              padding: 16px;

              border-radius: 18px;
            }

            .lecture-card {
              min-width: 245px;
              width: 245px;
            }

            .quick-grid {
              gap: 10px;
            }

            .quick-card {
              min-height: 155px;

              padding: 16px;

              border-radius: 17px;
            }

            .quick-card-description {
              font-size: 9px;

              line-height: 15px;
            }
          }


          @media (max-width: 480px) {
            .dashboard-container {
              padding-left: 10px;
              padding-right: 10px;
            }

            .dashboard-hero {
              padding: 24px 20px;
            }

            .hero-label {
              font-size: 8px;
            }

            .hero-title {
              font-size: 25px;
            }

            .quick-grid {
              grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .quick-card {
              min-height: 160px;
            }

            .quick-icon {
              width: 42px;
              height: 42px;

              margin-bottom: 14px;
            }

            .quick-card-title {
              font-size: 12px;
            }

            .quick-arrow {
              width: 28px;
              height: 28px;

              right: 13px;
              bottom: 13px;
            }
          }
        </style>


        <div class="md:ml-60 pt-14 dashboard-shell">

          <main class="dashboard-container">


            <!-- =====================================================
         HERO
    ====================================================== -->

            <section class="dashboard-hero">

              <div class="hero-grid">

