<%- include('./partials/head', { title: 'Sign In' }) %>
<body class="min-h-screen bg-slate-950 flex text-white font-sans selection:bg-garud-highlight selection:text-white">

  <!-- Left Column (Branding/Graphics) - Hidden on mobile -->
  <div class="hidden lg:flex w-[45%] relative flex-col justify-between p-14 overflow-hidden bg-gradient-to-br from-[#0B1021] to-slate-950 border-r border-white/5 shadow-[20px_0_40px_rgba(0,0,0,0.5)] z-20">
     <!-- Animated background elements -->
     <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-garud-highlight rounded-full mix-blend-screen filter blur-[120px] opacity-30 animate-pulse" style="animation-duration: 8s;"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] bg-[#FF3366] rounded-full mix-blend-screen filter blur-[120px] opacity-20 animate-pulse" style="animation-duration: 10s;"></div>
     </div>
     
     <div class="relative z-10 fade-up">
        <a href="/" class="inline-flex items-center gap-3 hover:opacity-80 transition-opacity">
           <img src="/images/logo.png" alt="Garud Classes" class="w-12 h-12 object-contain drop-shadow-2xl" />
           <span class="text-2xl font-black tracking-widest text-white">GARUD<span class="text-garud-highlight">CLASSES</span></span>
        </a>
     </div>

     <div class="relative z-10 mt-auto pb-12 fade-up" style="animation-delay: 100ms;">
        <h1 class="text-[3.5rem] font-black leading-[1.1] mb-6 tracking-tight">Welcome to the<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-garud-highlight to-[#FF3366]">Future of Learning.</span></h1>
        <p class="text-lg text-white/50 max-w-md leading-relaxed font-medium">Access your personalized dashboard, attempt tests with real-time analytics, and track your performance effortlessly.</p>
     </div>
     
     <!-- Floating elements -->
     <div class="absolute top-1/3 right-[10%] bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-4 shadow-2xl transform rotate-3 float-animation hidden xl:block">
        <div class="flex items-center gap-3">
           <div class="w-10 h-10 rounded-full bg-garud-highlight/20 flex items-center justify-center text-garud-highlight">📈</div>
           <div>
              <div class="text-sm font-bold">Top 1%</div>
              <div class="text-[10px] text-white/50 uppercase tracking-wider">in recent mock test</div>
           </div>
        </div>
     </div>
  </div>

  <!-- Right Column (Form) -->
  <div class="w-full lg:w-[55%] flex flex-col items-center justify-center relative p-6 sm:p-12 overflow-hidden bg-[#0A0D14]">
     <!-- Mobile background blobs -->
     <div class="lg:hidden absolute top-[-20%] left-[-10%] w-72 h-72 bg-garud-highlight/10 rounded-full blur-3xl pointer-events-none"></div>
     <div class="lg:hidden absolute bottom-[-20%] right-[-10%] w-64 h-64 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>

     <div class="max-w-[420px] w-full relative z-10">
        <!-- Mobile Logo -->
        <div class="lg:hidden text-center mb-10 fade-up">
          <img src="/images/logo.png" alt="Garud Classes" class="w-20 h-20 mx-auto mb-4 object-contain drop-shadow-xl" />
          <h1 class="text-3xl font-black tracking-tight">GARUD<span class="text-garud-highlight">CLASSES</span></h1>
        </div>

        <div class="mb-10 text-center lg:text-left fade-up" style="animation-delay: 100ms;">
           <h2 class="text-3xl sm:text-4xl font-bold mb-3 tracking-tight">Sign in to your account</h2>
           <p class="text-white/50 font-medium">Enter your credentials to access the portal.</p>
        </div>

        <form id="login-form" class="space-y-5 fade-up" style="animation-delay: 200ms;" novalidate>
          
          <div id="step-1-email">
            <label class="block text-[11px] font-bold text-white/50 uppercase tracking-widest mb-2">Email Address</label>
            <div class="relative group">
              <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-white/30 group-focus-within:text-garud-highlight transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </span>
              <input id="email" type="email" autocomplete="email" inputmode="email"
                     class="w-full pl-12 pr-4 py-3.5 bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl focus:bg-white/10 focus:ring-2 focus:ring-garud-highlight focus:border-garud-highlight outline-none transition-all duration-200"
                     placeholder="Enter your email" required/>
            </div>
            <button id="continue-btn" type="button"
                    class="w-full py-3.5 bg-white/10 hover:bg-white/20 border border-white/10 text-white font-bold rounded-xl shadow-lg active:scale-[0.98] transition-all duration-200 mt-6">
              Continue
            </button>
          </div>

          <div id="step-2-password" class="hidden animate-fade-in-up space-y-5">
            <div class="flex items-center justify-between text-sm mb-2 bg-garud-highlight/10 px-4 py-3 rounded-xl border border-garud-highlight/20">
              <div class="flex flex-col">
                <span class="text-[10px] text-garud-highlight uppercase font-bold tracking-wider mb-0.5">Continuing as</span>
                <span class="text-white font-medium" id="display-email"></span>
              </div>
              <button type="button" id="change-email-btn" class="text-garud-highlight font-bold text-xs uppercase tracking-wide hover:underline">Change</button>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                 <label class="block text-[11px] font-bold text-white/50 uppercase tracking-widest">Password</label>
                 <button id="forgot-open-btn" type="button" class="text-[11px] text-garud-highlight font-bold hover:underline transition">Forgot Password?</button>
              </div>
              <div class="relative group">
                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-white/30 group-focus-within:text-garud-highlight transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                </span>
                <input id="password" type="password" autocomplete="current-password"
                       class="w-full pl-12 pr-12 py-3.5 bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl focus:bg-white/10 focus:ring-2 focus:ring-garud-highlight focus:border-garud-highlight outline-none transition-all duration-200"
                       placeholder="Enter your password" required/>
                <button id="toggle-password" type="button" class="absolute inset-y-0 right-0 flex items-center pr-4 text-white/30 hover:text-white transition-colors">
                  <svg id="eye-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <svg id="eye-closed" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Submit Button -->
            <button id="submit-btn" type="submit"
                    class="w-full py-4 bg-gradient-to-r from-garud-highlight to-rose-600 hover:from-rose-500 hover:to-garud-highlight text-white font-black tracking-wide rounded-xl shadow-[0_0_20px_rgba(244,63,94,0.3)] active:scale-[0.98] transition-all duration-200 disabled:opacity-50 mt-6 text-lg relative overflow-hidden group">
              <span class="relative z-10">Sign In</span>
              <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
            </button>
          </div>
        </form>

        <p class="mt-8 text-center text-sm text-white/50 font-medium fade-up" style="animation-delay: 300ms;">
          Don't have an account?
          <a href="/register" class="text-garud-highlight font-bold hover:text-rose-400 hover:underline transition-colors ml-1">Register here</a>
        </p>

        <div class="mt-10 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-center gap-4 text-[11px] text-white/40 fade-up" style="animation-delay: 400ms;">
          <a href="tel:9896913009" class="flex items-center gap-2 hover:text-white transition-colors bg-white/5 px-3 py-1.5 rounded-full border border-white/5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-garud-highlight" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            9896913009
          </a>
          <a href="mailto:info@garudclasses.com" class="flex items-center gap-2 hover:text-white transition-colors bg-white/5 px-3 py-1.5 rounded-full border border-white/5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-garud-highlight" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            info@garudclasses.com
          </a>
        </div>
     </div>
  </div>

  <%- include('./partials/toast') %>
  
  <!-- Forgot Password Modal -->
  <div id="forgot-modal" class="hidden fixed inset-0 z-50 backdrop-blur-sm">
    <div class="absolute inset-0 bg-black/80 transition-opacity"></div>
    <div class="relative z-10 min-h-screen flex items-center justify-center p-4">
      <div class="w-full max-w-md rounded-3xl bg-[#111520] border border-white/10 p-8 shadow-2xl animate-fade-in-up">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-bold tracking-tight">Reset Password</h3>
          <button id="forgot-close-btn" type="button" class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 text-white/60 hover:text-white hover:bg-white/10 transition">&times;</button>
        </div>
        <div id="fp-step1" class="space-y-4">
          <p class="text-sm text-white/50 mb-2">Enter your email or username to receive a reset link.</p>
          <input id="fp-identifier" type="text" placeholder="Email or username" class="w-full px-4 py-3 bg-white/5 border border-white/10 text-white rounded-xl focus:ring-2 focus:ring-garud-highlight outline-none transition"/>
          <button id="fp-send-otp-btn" type="button" class="w-full py-3.5 bg-garud-highlight hover:bg-rose-500 text-white rounded-xl font-bold transition shadow-lg mt-2">Send Reset Link</button>
        </div>
        <div id="fp-step2" class="hidden text-sm text-center py-6">
          <div class="w-16 h-16 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center mx-auto mb-4 text-2xl">✓</div>
          <p class="text-white/70 font-medium">Reset link sent! Please check your email inbox.</p>
        </div>
        <div id="fp-step3" class="hidden space-y-4">
          <p class="text-sm text-white/50 mb-2">Enter your new secure password.</p>
          <input id="fp-new-password" type="password" placeholder="New password (min 8 chars)" class="w-full px-4 py-3 bg-white/5 border border-white/10 text-white rounded-xl focus:ring-2 focus:ring-garud-highlight outline-none transition"/>
          <button id="fp-set-password-btn" type="button" class="w-full py-3.5 bg-garud-highlight hover:bg-rose-500 text-white rounded-xl font-bold transition shadow-lg mt-2">Set New Password</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/pages/public/login.js"></script>

  <style>
    @keyframes float-animation {
      0% { transform: translateY(0) rotate(3deg); }
      50% { transform: translateY(-10px) rotate(5deg); }
      100% { transform: translateY(0) rotate(3deg); }
    }
    .float-animation {
      animation: float-animation 6s ease-in-out infinite;
    }
  </style>
</body>
</html>
