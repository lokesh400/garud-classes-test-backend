<%- include('./partials/head', { title: 'Register' }) %>
<body class="min-h-screen bg-slate-950 flex text-white font-sans selection:bg-garud-highlight selection:text-white">

  <!-- Left Column (Branding/Graphics) - Hidden on mobile -->
  <div class="hidden lg:flex w-[45%] relative flex-col justify-between p-14 overflow-hidden bg-gradient-to-br from-[#0B1021] to-slate-950 border-r border-white/5 shadow-[20px_0_40px_rgba(0,0,0,0.5)] z-20">
     <!-- Animated background elements -->
     <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px] bg-garud-highlight rounded-full mix-blend-screen filter blur-[120px] opacity-30 animate-pulse" style="animation-duration: 8s;"></div>
        <div class="absolute bottom-[-10%] left-[-10%] w-[500px] h-[500px] bg-[#3B82F6] rounded-full mix-blend-screen filter blur-[120px] opacity-20 animate-pulse" style="animation-duration: 10s;"></div>
     </div>
     
     <div class="relative z-10 fade-up">
        <a href="/" class="inline-flex items-center gap-3 hover:opacity-80 transition-opacity">
           <img src="/images/logo.png" alt="Garud Classes" class="w-12 h-12 object-contain drop-shadow-2xl" />
           <span class="text-2xl font-black tracking-widest text-white">GARUD<span class="text-garud-highlight">CLASSES</span></span>
        </a>
     </div>

     <div class="relative z-10 mt-auto pb-12 fade-up" style="animation-delay: 100ms;">
        <h1 class="text-[3.5rem] font-black leading-[1.1] mb-6 tracking-tight">Begin Your<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-garud-highlight to-[#3B82F6]">Journey With Us.</span></h1>
        <p class="text-lg text-white/50 max-w-md leading-relaxed font-medium">Join thousands of students. Prepare with the best mock tests and detailed insights to crack your target exams.</p>
     </div>
     
     <!-- Floating elements -->
     <div class="absolute top-1/4 right-[5%] bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-4 shadow-2xl transform -rotate-3 float-animation hidden xl:block" style="animation-delay: -3s;">
        <div class="flex items-center gap-3">
           <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-400">🎓</div>
           <div>
              <div class="text-sm font-bold">10,000+</div>
              <div class="text-[10px] text-white/50 uppercase tracking-wider">Students Joined</div>
           </div>
        </div>
     </div>
  </div>

  <!-- Right Column (Form) -->
  <div class="w-full lg:w-[55%] flex flex-col items-center justify-center relative p-6 sm:p-12 overflow-hidden bg-[#0A0D14]">
     <!-- Mobile background blobs -->
     <div class="lg:hidden absolute top-[-20%] right-[-10%] w-72 h-72 bg-garud-highlight/10 rounded-full blur-3xl pointer-events-none"></div>
     <div class="lg:hidden absolute bottom-[-20%] left-[-10%] w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

     <div class="max-w-[420px] w-full relative z-10">
        <!-- Mobile Logo -->
        <div class="lg:hidden text-center mb-10 fade-up">
          <img src="/images/logo.png" alt="Garud Classes" class="w-20 h-20 mx-auto mb-4 object-contain drop-shadow-xl" />
          <h1 class="text-3xl font-black tracking-tight">GARUD<span class="text-garud-highlight">CLASSES</span></h1>
        </div>

        <div class="mb-10 text-center lg:text-left fade-up" style="animation-delay: 100ms;">
           <h2 class="text-3xl sm:text-4xl font-bold mb-3 tracking-tight">Create your account</h2>
           <p class="text-white/50 font-medium">Step into a personalized learning experience.</p>
        </div>

        <!-- Step indicator -->
        <div class="flex items-center justify-center lg:justify-start gap-3 mb-8 text-sm font-bold fade-up" style="animation-delay: 150ms;" id="step-indicator">
          <span id="step1-label" class="text-garud-highlight px-3 py-1 bg-garud-highlight/10 rounded-full border border-garud-highlight/20 transition-all">Step 1</span>
          <span class="text-white/20">›</span>
          <span id="step2-label" class="text-white/40 px-3 py-1 rounded-full border border-transparent transition-all">Step 2</span>
          <span class="text-white/20">›</span>
          <span id="step3-label" class="text-white/40 px-3 py-1 rounded-full border border-transparent transition-all">Review</span>
        </div>

        <form id="register-form" novalidate class="space-y-5 fade-up" style="animation-delay: 200ms;">
          
          <!-- Step 1 -->
          <div id="step-1" class="space-y-5">
            <div>
              <label class="block text-[11px] font-bold text-white/50 uppercase tracking-widest mb-2">Full Name</label>
              <input id="name" type="text" placeholder="Your full name" autocomplete="name"
                     class="w-full px-4 py-3.5 bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl focus:bg-white/10 focus:ring-2 focus:ring-garud-highlight focus:border-garud-highlight outline-none transition-all duration-200"/>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-[11px] font-bold text-white/50 uppercase tracking-widest mb-2">Class</label>
                <select id="studentClass"
                        class="w-full px-4 py-3.5 bg-white/5 border border-white/10 text-white rounded-xl focus:bg-white/10 focus:ring-2 focus:ring-garud-highlight outline-none transition-all duration-200 appearance-none">
                  <option value="" class="text-gray-800">Select</option>
                  <option class="text-gray-800">9</option><option class="text-gray-800">10</option><option class="text-gray-800">11</option><option class="text-gray-800">12</option><option class="text-gray-800">Dropper</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-bold text-white/50 uppercase tracking-widest mb-2">Target Exam</label>
                <select id="targetExam"
                        class="w-full px-4 py-3.5 bg-white/5 border border-white/10 text-white rounded-xl focus:bg-white/10 focus:ring-2 focus:ring-garud-highlight outline-none transition-all duration-200 appearance-none">
                  <option value="" class="text-gray-800">Select</option>
                  <option class="text-gray-800">JEE</option><option class="text-gray-800">NEET</option><option class="text-gray-800">FOUNDATION</option><option class="text-gray-800">CUET</option><option class="text-gray-800">NDA</option>
                </select>
              </div>
            </div>
            
            <div class="pt-2">
              <button type="button" id="next-1"
                      class="w-full py-4 bg-garud-highlight hover:bg-rose-500 text-white font-bold tracking-wide rounded-xl shadow-lg active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2">
                Continue <span>&rarr;</span>
              </button>
            </div>
          </div>

          <!-- Step 2 -->
          <div id="step-2" class="hidden space-y-5 animate-fade-in-up">
            <div>
              <label class="block text-[11px] font-bold text-white/50 uppercase tracking-widest mb-2">Mobile Number</label>
              <input id="mobile" type="tel" placeholder="10-digit mobile number" autocomplete="tel" inputmode="tel"
                     class="w-full px-4 py-3.5 bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl focus:bg-white/10 focus:ring-2 focus:ring-garud-highlight outline-none transition-all duration-200"/>
            </div>
            <div>
              <label class="block text-[11px] font-bold text-white/50 uppercase tracking-widest mb-2">Email Address</label>
              <input id="email" type="email" placeholder="your@email.com" autocomplete="email" inputmode="email"
                     class="w-full px-4 py-3.5 bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl focus:bg-white/10 focus:ring-2 focus:ring-garud-highlight outline-none transition-all duration-200"/>
            </div>
            <div>
              <label class="block text-[11px] font-bold text-white/50 uppercase tracking-widest mb-2">Password</label>
              <input id="password" type="password" placeholder="Choose a secure password" autocomplete="new-password"
                     class="w-full px-4 py-3.5 bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl focus:bg-white/10 focus:ring-2 focus:ring-garud-highlight outline-none transition-all duration-200"/>
            </div>
            
            <div class="flex gap-3 pt-2">
              <button type="button" id="prev-2" class="w-1/3 py-4 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold rounded-xl transition-all duration-200 active:scale-[0.98]">Back</button>
              <button type="button" id="next-2" class="w-2/3 py-4 bg-garud-highlight hover:bg-rose-500 text-white font-bold rounded-xl shadow-lg transition-all duration-200 active:scale-[0.98] flex items-center justify-center gap-2">Review <span>&rarr;</span></button>
            </div>
          </div>

          <!-- Step 3 (Review) -->
          <div id="step-3" class="hidden animate-fade-in-up space-y-6">
            
            <div class="bg-white/5 rounded-2xl p-6 border border-white/10 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-32 h-32 bg-garud-highlight/10 rounded-full blur-2xl -mr-10 -mt-10"></div>
              
              <h3 class="text-sm font-bold text-white mb-5 uppercase tracking-widest border-b border-white/10 pb-3">Review Details</h3>
              
              <div class="space-y-4">
                <div class="flex items-start justify-between border-b border-white/5 pb-3">
                  <span class="text-xs text-white/40 uppercase tracking-wider font-bold w-1/3">Name</span>
                  <span id="review-name" class="text-sm font-medium text-white text-right w-2/3"></span>
                </div>
                <div class="flex items-start justify-between border-b border-white/5 pb-3">
                  <span class="text-xs text-white/40 uppercase tracking-wider font-bold w-1/3">Class</span>
                  <span id="review-class" class="text-sm font-medium text-white text-right w-2/3"></span>
                </div>
                <div class="flex items-start justify-between border-b border-white/5 pb-3">
                  <span class="text-xs text-white/40 uppercase tracking-wider font-bold w-1/3">Target</span>
                  <span id="review-target" class="text-sm font-medium text-white text-right w-2/3"></span>
                </div>
                <div class="flex items-start justify-between border-b border-white/5 pb-3">
                  <span class="text-xs text-white/40 uppercase tracking-wider font-bold w-1/3">Mobile</span>
                  <span id="review-mobile" class="text-sm font-medium text-white text-right w-2/3"></span>
                </div>
                <div class="flex items-start justify-between">
                  <span class="text-xs text-white/40 uppercase tracking-wider font-bold w-1/3">Email</span>
                  <span id="review-email" class="text-sm font-medium text-white text-right w-2/3 truncate pl-2"></span>
                </div>
              </div>
            </div>
            
            <div class="flex gap-3 pt-2">
              <button type="button" id="prev-3" class="w-1/3 py-4 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold rounded-xl transition-all duration-200 active:scale-[0.98]">Edit</button>
              
              <button id="submit-btn" type="submit"
                      class="w-2/3 py-4 bg-gradient-to-r from-garud-highlight to-rose-600 hover:from-rose-500 hover:to-garud-highlight text-white font-black tracking-wide rounded-xl shadow-[0_0_20px_rgba(244,63,94,0.3)] active:scale-[0.98] transition-all duration-200 disabled:opacity-50 text-lg relative overflow-hidden group">
                <span class="relative z-10 flex items-center justify-center gap-2">
                  Create Account
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </span>
                <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
              </button>
            </div>
          </div>
        </form>

        <p class="mt-8 text-center text-sm text-white/50 font-medium fade-up" style="animation-delay: 300ms;">
          Already have an account?
          <a href="/login" class="text-garud-highlight font-bold hover:text-rose-400 hover:underline transition-colors ml-1">Sign in here</a>
        </p>

     </div>
  </div>

  <%- include('./partials/toast') %>
  <script src="/js/api.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/pages/public/register.js"></script>
  
  <style>
    @keyframes float-animation {
      0% { transform: translateY(0) rotate(-3deg); }
      50% { transform: translateY(-10px) rotate(-1deg); }
      100% { transform: translateY(0) rotate(-3deg); }
    }
    .float-animation {
      animation: float-animation 7s ease-in-out infinite;
    }
  </style>
</body>
</html>
